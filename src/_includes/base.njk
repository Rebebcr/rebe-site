<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {%- if pag.esInicio %}
  <title>{{ pag.titulo }}</title>
  {%- else %}
  <title>{{ pag.titulo }} — {{ ajustes.nombre_sitio }}</title>
  {%- endif %}
  <meta name="description" content="{{ pag.descripcion or ajustes.descripcion }}">
  <meta property="og:title" content="{{ pag.titulo }}">
  <meta property="og:description" content="{{ pag.descripcion or ajustes.descripcion }}">
  {%- set imagenCompartir = pag.imagen_compartir or ajustes.imagen_compartir %}
  {%- if imagenCompartir %}
  <meta property="og:image" content="{{ ajustes.dominio }}{{ imagenCompartir }}">
  {%- endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="icon" type="image/png" href="{{ ajustes.icono or ajustes.logo }}">
  <link rel="stylesheet" href="/styles.css">
  {%- if ajustes.codigo_head %}
  {{ ajustes.codigo_head | safe }}
  {%- endif %}
</head>
<body>

  <header class="nav-wrap{% if not ajustes.menu or ajustes.menu.length == 0 %} nav-simple{% endif %}" id="top">
    <nav class="nav container">
      <a href="/" class="nav-brand" aria-label="{{ ajustes.nombre_sitio }} — Inicio">
        <img src="{{ ajustes.logo }}" alt="{{ ajustes.nombre_sitio }}" class="nav-logo">
      </a>

      <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <div class="nav-links" id="navLinks">
        {%- for item in ajustes.menu %}
        {%- set url = item.enlace | enlace(pag.esInicio) %}
        <a href="{{ url }}"{% if url == pag.url %} class="is-active" aria-current="page"{% endif %}{% if item.nueva_pestana %} target="_blank" rel="noopener"{% endif %}>{{ item.texto }}</a>
        {%- endfor %}
        {%- if ajustes.boton_menu and ajustes.boton_menu.texto %}
        <a href="{{ ajustes.boton_menu.enlace | enlace(pag.esInicio) }}" class="btn btn-gold nav-cta"{% if ajustes.boton_menu.nueva_pestana %} target="_blank" rel="noopener"{% endif %}>{{ ajustes.boton_menu.texto }}</a>
        {%- endif %}
      </div>
    </nav>
  </header>

  <main>
{{ content | safe }}
  </main>

  <footer class="footer">
    <div class="container center">
      <img src="{{ ajustes.logo_pie or ajustes.logo }}" alt="{{ ajustes.nombre_sitio }}" class="footer-logo">
      {%- if ajustes.redes and ajustes.redes.length %}
      <div class="footer-social">
        {%- for r in ajustes.redes %}
        <a href="{{ r.enlace }}" target="_blank" rel="noopener" aria-label="{{ r.red | capitalize }}">{% include "iconos/" + r.red + ".njk" ignore missing %}</a>
        {%- endfor %}
      </div>
      {%- endif %}
      <div class="gold-divider"></div>
      <p class="footer-copy">{{ (ajustes.pie_texto or "") | replace("{año}", "" | anio) }}</p>
    </div>
  </footer>

  <script src="/script.js"></script>
  {%- if ajustes.codigo_body %}
  {{ ajustes.codigo_body | safe }}
  {%- endif %}
</body>
</html>
